NODE_ENV=production
APP_URL=https://cases.example.org
NEXT_PUBLIC_APP_URL=https://cases.example.org

DB_HOST=database.internal
DB_PORT=3306
DB_USER=blockchain_app
DB_PASSWORD_FILE=/run/secrets/db_password
DB_NAME=blockchain
DB_SSL_CA_FILE=/run/secrets/db_ca
DB_SSL_REJECT_UNAUTHORIZED=true

JUDGE_AI_SERVICE_URL=http://ai-judge:5000

FABRIC_ACCESS_MODE=direct
FABRIC_PEER_ENDPOINT=peer0.org1.example.com:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=caseflow
FABRIC_TLS_CERT_PATH=/run/secrets/fabric_tls_cert
FABRIC_CLIENT_CERT_PATH=/run/secrets/fabric_client_cert
FABRIC_CLIENT_KEY_PATH=/run/secrets/fabric_client_key
FABRIC_BRIDGE_URL=
FABRIC_BRIDGE_TOKEN=change_this_bridge_token
FABRIC_BRIDGE_TIMEOUT_MS=15000
FABRIC_BRIDGE_ONLY=false
