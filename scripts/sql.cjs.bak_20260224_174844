const fs = require("fs");
const mysql = require("mysql2/promise");
require("dotenv").config({ path: ".env.local", override: true });

(async () => {
  const sql = process.argv.slice(2).join(" ").trim();
  if (!sql) {
    console.log("Usage:");
    console.log('  node scripts/sql.cjs "SHOW TABLES"');
    console.log('  node scripts/sql.cjs "DESCRIBE users"');
    process.exit(0);
  }

  const {
    DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME, DB_SSL_CA
  } = process.env;

  const conn = await mysql.createConnection({
    host: DB_HOST,
    port: Number(DB_PORT),
    user: DB_USER,
    password: DB_PASSWORD,
    database: DB_NAME,
    ssl: DB_SSL_CA ? { ca: fs.readFileSync(DB_SSL_CA) } : undefined,
  });

  const [rows] = await conn.query(sql);
  console.table(rows);
  await conn.end();
})().catch(err => {
  console.error("SQL ERROR:", err.code || "");
  console.error(err.message);
  process.exit(1);
});
